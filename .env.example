# Lokal (shopify app dev setzt SHOPIFY_* selbst)
DATABASE_URL="postgresql://app:app@localhost:5432/eu_label"
DIRECT_URL="postgresql://app:app@localhost:5432/eu_label"
APP_HANDLE="eu-gewaehrleistungslabel"

# Produktion: als Fly-Secrets setzen, NICHT committen
# SHOPIFY_API_KEY=        (Client-ID der Produktions-App)
# SHOPIFY_API_SECRET=     (Client-Secret der Produktions-App)
# DATABASE_URL=           (Neon: "pooled" Connection-String, ?sslmode=require)
# DIRECT_URL=             (Neon: direkter Connection-String, für Migrationen)
